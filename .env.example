# Local setup: cp .env.example .env, then php artisan key:generate. APP_DEBUG=true is fine on your own computer only.

APP_NAME=Rongshikha
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dhaka
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rongshikha
DB_USERNAME=root
DB_PASSWORD=        

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Behind Cloudflare / a load balancer / a hosting proxy? Uncomment so real visitor IPs are used.
# TRUSTED_PROXIES=*

VITE_APP_NAME="${APP_NAME}"

# Shop numbers
SHOP_SHIPPING_FEE=60
SHOP_LOW_STOCK_THRESHOLD=5
SHOP_STOREFRONT_CACHE=120
SHOP_POPULAR_CACHE=600
SHOP_STATS_CACHE=120

# bKash / Nagad (manual, both Personal): the customer sends the 20% advance, then types the transaction ID.
# The rest is cash on delivery. Admin marks the advance as checked.
SHOP_PAYMENT_METHODS=bkash,nagad
SHOP_BKASH_NUMBER=01907852281
SHOP_BKASH_TYPE=Personal
SHOP_NAGAD_NUMBER=01XXXXXXXXX      # CHANGE: the client's Nagad Personal number
SHOP_NAGAD_TYPE=Personal

# Paintings at/above this price show under Statement pieces, the rest under Small canvases.
SHOP_ADVANCE_PERCENT=20
SHOP_ORDER_EMAILS=processing
SHOP_PREMIUM_FROM=2000
# The "Visit us" map. Plus Code + area; open the map on the site once and check the pin is right.
SHOP_MAP_QUERY=
SHOP_MAP_LINK=

SHOP_ADDRESS=                          # optional: leave empty for an online-only shop
SHOP_PHONE="+880 1907-852281"          # ONE number for contact + hotline (top bar, footer, Contact page)
SHOP_EMAIL=homemadeelegance4050@gmail.com
SHOP_WHATSAPP=8801907852281            # same number; floating WhatsApp icon + footer button
SHOP_HOURS=

# CHANGE: paste the real page links of Rongshikha (leave empty for any she does not have)
SHOP_FACEBOOK=
SHOP_INSTAGRAM=
SHOP_TIKTOK=
SHOP_YOUTUBE=
SHOP_X=

SHOP_SETTINGS_ACCESS=true
SHOP_FREE_SHIPPING_OVER=0

# First setup:  php artisan migrate --force && php artisan db:seed --class=RongshikhaSeeder --force
#   then create the admin:  php artisan shop:admin you@example.com --replace   (asks for the password)
#   and sign in at  your-site.com/admin/login

# Free email through Gmail (password-reset codes, order emails). Make an "App password" in the Google account
# (Security > 2-Step Verification > App passwords), paste the 16 letters below and set MAIL_MAILER=smtp.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=homemadeelegance4050@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="homemadeelegance4050@gmail.com"

MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------------------------
# DEVELOPER / RESELLER CONTROLS. Only you change these (the admin panel cannot).
# ---------------------------------------------------------------------------------------------
# true = shop name, tagline, logo, favicon and brand colour come only from the lines below and vanish from
# Admin > Settings. false = the owner can edit them there (use this on your own copy).
SHOP_BRANDING_LOCK=true
SHOP_NAME="Rongshikha"
#SHOP_TAGLINE=
#SHOP_META_DESCRIPTION=
#SHOP_LOGO=/images/rongshikha/logo.png
#SHOP_FAVICON=/images/rongshikha/icon.png
#SHOP_BRAND_COLOR=#16a34a

# Domains this copy may run on (comma separated). Any other domain shows a "not licensed" page. Empty = no check.
SHOP_LICENSED_DOMAINS=

# Turn a feature off for this client: false hides it from the shop and the admin menu.
FEATURE_REVIEWS=true
FEATURE_QA=true
FEATURE_WISHLIST=true
FEATURE_COUPONS=true
FEATURE_TRACK_ORDER=true

# Small credit line in the footer. Empty hides it.
SHOP_CREDIT_TEXT="Developed by Xovelt Labs"
SHOP_CREDIT_URL=
